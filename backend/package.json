{
  "name": "dgs-rent-backend",
  "version": "1.0.0",
  "description": "DGS Rent a Car - API REST (auth JWT, vehiculos, reservaciones)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "lint": "eslint src"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.2.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "src/server.js",
      "src/db/seed.js"
    ],
    "coverageThreshold": {
      "./src/routes/auth.js": {
        "statements": 80,
        "branches": 70,
        "functions": 80,
        "lines": 80
      },
      "./src/routes/vehicles.js": {
        "statements": 80,
        "branches": 70,
        "functions": 80,
        "lines": 80
      }
    }
  },
  "engines": {
    "node": "22.x"
  }
}
